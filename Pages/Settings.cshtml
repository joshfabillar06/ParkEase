@page
@model parkEASE.Pages.SettingsModel
@{
    ViewData["Title"] = "System Settings";
}

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }
    .page-title { font-size: 1.5rem; font-weight: bold; }
    .page-time { color: var(--text-muted); font-size: 0.9rem; }

    .settings-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 25px;
    }

    .card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 25px;
    }

    .card-title {
        font-size: 1.1rem;
        font-weight: bold;
        margin-top: 0;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Appearance Theme Controls */
    .theme-options {
        display: flex;
        gap: 15px;
    }
    .theme-card {
        flex: 1;
        border: 2px solid var(--border-color);
        border-radius: 10px;
        padding: 20px;
        cursor: pointer;
        text-align: center;
        transition: all 0.2s ease;
        background-color: var(--bg-sidebar);
    }
    .theme-card:hover {
        border-color: var(--accent-blue);
    }
    .theme-card.active {
        border-color: var(--accent-blue);
        background-color: rgba(59, 130, 246, 0.1);
    }
    .theme-icon {
        font-size: 1.8rem;
        margin-bottom: 10px;
    }

    /* Hourly Rate Inputs */
    .rates-form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .form-group { margin-bottom: 15px; }
    .form-label { display: block; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px; }
    .form-input {
        width: 100%;
        padding: 12px;
        background-color: var(--bg-sidebar);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        color: var(--text-primary);
        box-sizing: border-box;
        font-size: 0.9rem;
    }
    .form-input:focus { outline: none; border-color: var(--accent-blue); }

    .btn-save {
        background-color: var(--accent-blue);
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        transition: background 0.2s;
    }
    .btn-save:hover { background-color: #2563EB; }

    /* Diagnostic Lists */
    .info-list { border-top: 1px solid var(--border-color); }
    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 14px 0;
        border-bottom: 1px solid var(--border-color);
        font-size: 0.88rem;
    }
    .info-row .label { color: var(--text-muted); }
    .info-row .value { font-weight: bold; }

    .badge-status {
        color: #10B981;
        background-color: rgba(16, 185, 129, 0.1);
        padding: 4px 10px;
        border-radius: 4px;
        font-weight: bold;
        font-size: 0.78rem;
    }

    .alert-success {
        background-color: rgba(16, 185, 129, 0.1);
        color: #10B981;
        border: 1px solid #10B981;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 0.85rem;
    }

    .alert-error {
        background-color: rgba(239, 68, 68, 0.1);
        color: #EF4444;
        border: 1px solid #EF4444;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 0.85rem;
    }

    .account-form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }
</style>

<div class="header-date">
    <i class="fa-regular fa-clock"></i>
    <span class="pageClock"></span>
</div>

<div class="settings-grid">
    <div>
        <!-- Appearance / Theme Selector (Available to Admin & Staff) -->
        <div class="card">
            <div class="card-title">
                <i class="fa-solid fa-palette" style="color: var(--accent-blue);"></i> Appearance Mode
            </div>

            <div class="theme-options">
                <div class="theme-card" id="theme-dark" onclick="setTheme('dark')">
                    <div class="theme-icon"><i class="fa-solid fa-moon" style="color: #3B82F6;"></i></div>
                    <div style="font-weight: bold;">Dark Mode</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">Default dark theme</div>
                </div>

                <div class="theme-card" id="theme-light" onclick="setTheme('light')">
                    <div class="theme-icon"><i class="fa-solid fa-sun" style="color: #F59E0B;"></i></div>
                    <div style="font-weight: bold;">Light Mode</div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">Clean light background</div>
                </div>
            </div>
        </div>

        <!-- Hourly Rates Card (ADMIN ONLY) -->
        @if (User.IsInRole("Admin"))
        {
            <div class="card">
                <div class="card-title">
                    <i class="fa-solid fa-tags" style="color: var(--accent-blue);"></i> Hourly Parking Rates (₱/hr)
                </div>

                @if (!string.IsNullOrEmpty(Model.StatusMessage))
                {
                    <div class="alert-success"><i class="fa-solid fa-circle-check"></i> @Model.StatusMessage</div>
                }

                <form method="post" asp-page-handler="SaveRates">
                    <div class="rates-form-grid">
                        <div class="form-group">
                            <label class="form-label">Sedan Rate</label>
                            <input type="number" step="0.01" asp-for="Rates.SedanRate" class="form-input" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">SUV Rate</label>
                            <input type="number" step="0.01" asp-for="Rates.SuvRate" class="form-input" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Van Rate</label>
                            <input type="number" step="0.01" asp-for="Rates.VanRate" class="form-input" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Motorcycle Rate</label>
                            <input type="number" step="0.01" asp-for="Rates.MotorcycleRate" class="form-input" required />
                        </div>
                    </div>

                    <button type="submit" class="btn-save">Save Rate Changes</button>
                </form>
            </div>
        }
    </div>

    <!-- Account Creation Section (ADMIN ONLY) -->
    @if (User.IsInRole("Admin"))
    {
        <div>
            <div class="card">
                <div class="card-title">
                    <i class="fa-solid fa-user-plus" style="color: var(--accent-blue);"></i> Create Staff / Administrator Account
                </div>

                @if (!string.IsNullOrEmpty(Model.AccountStatusMessage))
                {
                    <div class="alert-success"><i class="fa-solid fa-circle-check"></i> @Model.AccountStatusMessage</div>
                }
                @if (!string.IsNullOrEmpty(Model.AccountErrorMessage))
                {
                    <div class="alert-error"><i class="fa-solid fa-circle-exclamation"></i> @Model.AccountErrorMessage</div>
                }

                <form method="post" asp-page-handler="CreateAccount">
                    <div class="account-form-grid">
                        <div class="form-group">
                            <label class="form-label">Full Name</label>
                            <input type="text" asp-for="NewAccount.FullName" class="form-input" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Employee ID</label>
                            <input type="text" asp-for="NewAccount.EmployeeID" class="form-input" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Username</label>
                            <input type="text" asp-for="NewAccount.Username" class="form-input" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Role</label>
                            <select asp-for="NewAccount.Role" class="form-input" required>
                                <option value="Staff">Staff</option>
                                <option value="Admin">Administrator</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Password</label>
                            <input type="password" asp-for="NewAccount.Password" class="form-input" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Confirm Password</label>
                            <input type="password" asp-for="NewAccount.ConfirmPassword" class="form-input" required />
                        </div>
                    </div>

                    <button type="submit" class="btn-save">Create Account</button>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function setTheme(theme) {
            localStorage.setItem('parkease-theme', theme);
            document.documentElement.setAttribute('data-theme', theme);
            updateThemeUI();
        }

        function updateThemeUI() {
            const currentTheme = localStorage.getItem('parkease-theme') || 'dark';
            document.getElementById('theme-dark').classList.toggle('active', currentTheme === 'dark');
            document.getElementById('theme-light').classList.toggle('active', currentTheme === 'light');
        }

        document.addEventListener('DOMContentLoaded', updateThemeUI);
    </script>
}