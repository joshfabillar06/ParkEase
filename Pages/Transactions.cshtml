@page
@model parkEASE.Pages.TransactionsModel
@{
    ViewData["Title"] = "Transactions & Reports";
    var maxDailySales = Model.DailySales.Count > 0 ? Math.Max(1m, Model.DailySales.Max(x => x.Amount)) : 1m;
}
<style>
    .page-header{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:22px}
    .page-title{font-size:1.5rem;font-weight:700}.page-time,.muted{color:var(--text-muted)}
    .summary-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-bottom:20px}
    .summary-card,.filter-card,.table-card,.report-card{background:var(--bg-card);border:1px solid var(--border-color);border-radius:12px;padding:18px;margin-bottom:18px}
    .summary-label{color:var(--text-muted);font-size:.82rem;margin-bottom:8px}.summary-value{font-size:1.65rem;font-weight:750}
    .tabs{display:flex;gap:8px;border-bottom:1px solid var(--border-color);margin:4px 0 18px;padding-bottom:10px}
    .tab-btn{border:1px solid var(--border-color);border-radius:8px;padding:10px 16px;background:var(--bg-sub);color:var(--text-muted);font-weight:650;cursor:pointer}
    .tab-btn.active{background:var(--accent-blue);border-color:var(--accent-blue);color:#fff}
    .filter-form{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.form-input,.form-select{padding:10px 12px;background:var(--bg-sub);border:1px solid var(--border-color);border-radius:8px;color:var(--text-primary);font-size:.9rem;min-width:140px}
    .btn{border:0;border-radius:8px;padding:10px 16px;font-weight:650;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:7px}
    .btn-primary{background:var(--accent-blue);color:#fff}.btn-secondary{background:var(--bg-sub);color:var(--text-primary);border:1px solid var(--border-color)}
    .table-wrap{overflow-x:auto}.data-table{width:100%;border-collapse:collapse;text-align:left;min-width:1050px}.data-table th{color:var(--text-muted);font-size:.75rem;padding:11px 9px;border-bottom:1px solid var(--border-color);text-transform:uppercase;white-space:nowrap}.data-table td{padding:12px 9px;border-bottom:1px solid var(--border-color);font-size:.82rem;white-space:nowrap}
    .badge{display:inline-block;padding:4px 8px;border-radius:5px;font-size:.72rem;font-weight:700}.badge-paid{color:#10b981;background:rgba(16,185,129,.12)}.badge-parked{color:#f59e0b;background:rgba(245,158,11,.12)}
    .report-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:16px}.report-heading h2{margin:0 0 5px;font-size:1.2rem}.report-meta{font-size:.83rem;color:var(--text-muted)}
    .report-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:16px 0}.report-kpi{background:var(--bg-sub);border:1px solid var(--border-color);border-radius:9px;padding:14px}.report-kpi span{display:block;color:var(--text-muted);font-size:.77rem}.report-kpi strong{display:block;font-size:1.3rem;margin-top:5px}
    .report-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:16px}.report-subcard{background:var(--bg-sub);border:1px solid var(--border-color);border-radius:10px;padding:16px;min-width:0}.report-subcard h3{font-size:.98rem;margin:0 0 14px}
    .bar-chart{height:190px;display:flex;align-items:flex-end;gap:6px;padding-top:8px}.bar-item{flex:1;min-width:0;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:6px}.bar{width:100%;max-width:30px;min-height:2px;background:var(--accent-blue);border-radius:4px 4px 0 0}.bar-label{font-size:.65rem;color:var(--text-muted);white-space:nowrap;transform:rotate(-35deg);transform-origin:center top;margin-top:5px}
    .breakdown-table{width:100%;border-collapse:collapse;font-size:.84rem}.breakdown-table th,.breakdown-table td{text-align:left;padding:9px 5px;border-bottom:1px solid var(--border-color)}.breakdown-table th{color:var(--text-muted);font-size:.74rem}
    .report-note{font-size:.78rem;color:var(--text-muted);margin-top:14px}
    @@media(max-width:950px){.report-grid{grid-template-columns:1fr}.report-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @@media(max-width:650px){.summary-grid{grid-template-columns:1fr}.filter-form>*{width:100%}.report-kpis{grid-template-columns:1fr 1fr}}
    @@media print{
        body.printing-report *{visibility:hidden!important}
        body.printing-report #report-panel,body.printing-report #report-panel *{visibility:visible!important}
        body.printing-report #report-panel{display:block!important;position:absolute!important;left:0!important;top:0!important;width:100%!important;margin:0!important;padding:0!important;border:0!important;background:#fff!important;color:#111!important}
        body.printing-report #report-panel .report-card{background:#fff!important;color:#111!important;border:0!important;box-shadow:none!important}
        body.printing-report #report-panel .report-subcard,body.printing-report #report-panel .report-kpi{background:#fff!important;color:#111!important;border:1px solid #ccc!important;break-inside:avoid}
        body.printing-report #report-panel h2,body.printing-report #report-panel h3,body.printing-report #report-panel strong,body.printing-report #report-panel td{color:#111!important}
        body.printing-report #report-panel .report-meta,body.printing-report #report-panel .report-kpi span,body.printing-report #report-panel .report-note,body.printing-report #report-panel .bar-label{color:#444!important}
        body.printing-report #report-panel .bar{background:#555!important}
        body.printing-report #report-panel .btn,body.printing-report #report-panel button{display:none!important}
        body{background:#fff!important}
    }
</style>

<div class="header-date">
    <i class="fa-regular fa-clock"></i>
    <span class="pageClock"></span>
</div>

<div class="summary-grid">
    <div class="summary-card"><div class="summary-label">Filtered Records</div><div class="summary-value">@Model.TotalTransactions</div></div>
    <div class="summary-card"><div class="summary-label">Filtered Paid Revenue</div><div class="summary-value" style="color:#10b981">₱@Model.TotalRevenue.ToString("N2")</div></div>
    <div class="summary-card"><div class="summary-label">Access Level</div><div class="summary-value" style="color:var(--accent-blue);font-size:1.35rem">Admin Portal</div></div>
</div>

<div class="tabs" role="tablist" aria-label="Transactions sections">
    <button type="button" class="tab-btn active" data-tab="transactions-panel" role="tab" aria-selected="true">Transactions</button>
    <button type="button" class="tab-btn" data-tab="report-panel" role="tab" aria-selected="false">Report Generation</button>
</div>

<section id="transactions-panel" class="tab-panel">
    <div class="filter-card">
        <form method="get" class="filter-form">
            <input type="text" asp-for="SearchTerm" placeholder="Search plate number or ticket ID" class="form-input" style="flex:2" />
            <select asp-for="PaymentFilter" class="form-select" style="flex:1">
                <option value="All">All Payment Methods</option><option value="Cash">Cash</option><option value="GCash">GCash</option><option value="Pending">Pending</option>
            </select>
            <select asp-for="StatusFilter" class="form-select" style="flex:1">
                <option value="All">All Statuses</option><option value="Parked">Currently Parked</option><option value="Paid">Paid</option>
            </select>
            <input type="hidden" name="ReportStartDate" value="@Model.ReportStartDate?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="ReportEndDate" value="@Model.ReportEndDate?.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-filter"></i> Filter</button>
            <a href="/Transactions" class="btn btn-secondary">Reset</a>
        </form>
    </div>
    <div class="table-card">
        @if (Model.Transactions.Any())
        {
            <div class="table-wrap"><table class="data-table">
                <thead><tr><th>Ticket Ref</th><th>Plate Number</th><th>Vehicle</th><th>Slot</th><th>Status</th><th>Duration</th><th>Total Fee</th><th>Received</th><th>Change</th><th>Payment</th><th>Processed By</th><th>Entry Time</th><th>Exit Time</th></tr></thead>
                <tbody>
                @foreach (var txn in Model.Transactions)
                {
                    var isParked = txn.PaymentStatus == "Parked";
                    <tr>
                        <td style="color:var(--accent-blue);font-weight:700">@txn.TransactionID</td><td>@txn.PlateNumber</td><td>@txn.VehicleType</td><td>@(txn.ParkingSlot?.SlotName ?? "P--")</td>
                        <td><span class="badge @(isParked ? "badge-parked" : "badge-paid")">@txn.PaymentStatus</span></td>
                        <td>@(isParked ? "—" : txn.ParkingDuration + " hrs")</td><td>@(isParked ? "—" : "₱" + txn.TotalAmount.ToString("N2"))</td>
                        <td>@(isParked ? "—" : "₱" + txn.AmountReceived.ToString("N2"))</td><td>@(isParked ? "—" : "₱" + txn.ChangeDue.ToString("N2"))</td>
                        <td>@(isParked ? "—" : txn.PaymentMethod)</td><td>@(txn.User?.FullName ?? "System Staff")</td>
                        <td>@txn.EntryTime.ToString("MMM dd, yyyy hh:mm tt")</td><td>@(txn.ExitTime?.ToString("MMM dd, yyyy hh:mm tt") ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
        else { <p class="muted" style="text-align:center;padding:28px">No transactions found matching your filters.</p> }
    </div>
</section>

<section id="report-panel" class="tab-panel" style="display:none">
    <div class="report-card">
        <div class="report-heading">
            <div><h2>ParkEase Transaction Report</h2><div class="report-meta">Reporting period: @Model.ReportStartDate?.ToString("MMM dd, yyyy") – @Model.ReportEndDate?.ToString("MMM dd, yyyy")</div></div>
            <button type="button" class="btn btn-primary" id="export-report"><i class="fa-solid fa-file-pdf"></i> Export PDF</button>
        </div>
        <form method="get" class="filter-form" style="margin-bottom:18px">
            <label class="muted" for="ReportStartDate">From</label><input class="form-input" type="date" id="ReportStartDate" name="ReportStartDate" value="@Model.ReportStartDate?.ToString("yyyy-MM-dd")" />
            <label class="muted" for="ReportEndDate">To</label><input class="form-input" type="date" id="ReportEndDate" name="ReportEndDate" value="@Model.ReportEndDate?.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-chart-column"></i> Generate Report</button>
        </form>
        <div class="report-kpis">
            <div class="report-kpi"><span>Total Revenue Collected</span><strong>₱@Model.ReportRevenue.ToString("N2")</strong></div>
            <div class="report-kpi"><span>Tickets Created</span><strong>@Model.ReportTotalRecords</strong></div>
            <div class="report-kpi"><span>Paid Tickets</span><strong>@Model.ReportPaidCount</strong></div>
            <div class="report-kpi"><span>Average Completed Stay</span><strong>@Model.ReportAverageStayHours.ToString("0.0") hrs</strong></div>
        </div>
        <div class="report-grid">
            <div class="report-subcard">
                <h3>Sales Trend</h3>
                @if (Model.DailySales.Any(x => x.Amount > 0))
                {
                    <div class="bar-chart">
                    @foreach (var point in Model.DailySales)
                    {
                        var height = (double)(point.Amount / maxDailySales) * 100;
                        <div class="bar-item" title="@point.Label: ₱@point.Amount.ToString("N2")"><div class="bar" style="height:@Math.Max(2,height)%"></div><span class="bar-label">@point.Label</span></div>
                    }
                    </div>
                }
                else { <p class="muted">No paid sales in the selected period.</p> }
                <p class="report-note">Revenue is counted using the payment/exit date. Ticket counts use the vehicle entry date.</p>
            </div>
            <div class="report-subcard">
                <h3>Vehicle Type Breakdown</h3>
                @if (Model.VehicleBreakdown.Any())
                {
                    <table class="breakdown-table"><thead><tr><th>Vehicle</th><th>Tickets</th><th>Paid Sales</th></tr></thead><tbody>
                    @foreach (var item in Model.VehicleBreakdown) { <tr><td>@item.Label</td><td>@item.Count</td><td>₱@item.Amount.ToString("N2")</td></tr> }
                    </tbody></table>
                }
                else { <p class="muted">No ticket data for this period.</p> }
            </div>
            <div class="report-subcard">
                <h3>Payment Method Breakdown</h3>
                @if (Model.PaymentBreakdown.Any())
                {
                    <table class="breakdown-table"><thead><tr><th>Method</th><th>Payments</th><th>Revenue</th></tr></thead><tbody>
                    @foreach (var item in Model.PaymentBreakdown) { <tr><td>@item.Label</td><td>@item.Count</td><td>₱@item.Amount.ToString("N2")</td></tr> }
                    </tbody></table>
                }
                else { <p class="muted">No completed payments for this period.</p> }
            </div>
            <div class="report-subcard">
                <h3>Transaction Status</h3>
                <table class="breakdown-table"><tbody>
                    <tr><td>Paid / completed</td><td><strong>@Model.ReportPaidCount</strong></td></tr>
                    <tr><td>Currently parked</td><td><strong>@Model.ReportParkedCount</strong></td></tr>
                    <tr><td>All tickets in period</td><td><strong>@Model.ReportTotalRecords</strong></td></tr>
                </tbody></table>
            </div>
        </div>
        <div class="report-subcard" style="margin-top:16px">
            <h3>Transaction Details</h3>
            @if (Model.ReportTransactions.Any())
            {
                <div class="table-wrap"><table class="breakdown-table" style="min-width:750px"><thead><tr><th>Ticket</th><th>Plate</th><th>Vehicle</th><th>Slot</th><th>Entry</th><th>Exit</th><th>Duration</th><th>Status</th><th>Amount</th><th>Payment</th></tr></thead><tbody>
                @foreach (var txn in Model.ReportTransactions)
                {
                    <tr><td>@txn.TransactionID</td><td>@txn.PlateNumber</td><td>@txn.VehicleType</td><td>@(txn.ParkingSlot?.SlotName ?? "P--")</td><td>@txn.EntryTime.ToString("MMM dd, yyyy hh:mm tt")</td><td>@(txn.ExitTime?.ToString("MMM dd, yyyy hh:mm tt") ?? "—")</td><td>@(txn.PaymentStatus == "Paid" ? txn.ParkingDuration + " hrs" : "—")</td><td>@txn.PaymentStatus</td><td>@(txn.PaymentStatus == "Paid" ? "₱" + txn.TotalAmount.ToString("N2") : "—")</td><td>@(txn.PaymentStatus == "Paid" ? txn.PaymentMethod : "—")</td></tr>
                }
                </tbody></table></div>
            }
            else { <p class="muted">No transactions were created during the selected period.</p> }
        </div>
        <p class="report-note">Generated on @DateTime.Now.ToString("MMMM dd, yyyy hh:mm tt"). ParkEase internal report.</p>
    </div>
</section>

@section Scripts {
<script>
(() => {
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');
    function activateTab(id) {
        panels.forEach(panel => panel.style.display = panel.id === id ? 'block' : 'none');
        tabs.forEach(tab => {
            const active = tab.dataset.tab === id;
            tab.classList.toggle('active', active);
            tab.setAttribute('aria-selected', active ? 'true' : 'false');
        });
    }
    tabs.forEach(tab => tab.addEventListener('click', () => activateTab(tab.dataset.tab)));
    const exportButton = document.getElementById('export-report');
    if (exportButton) {
        exportButton.addEventListener('click', () => {
            activateTab('report-panel');
            document.body.classList.add('printing-report');
            window.addEventListener('afterprint', () => document.body.classList.remove('printing-report'), { once: true });
            window.print();
        });
    }
})();
</script>
}
